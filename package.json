{
  "name": "aln-historical-operations-dataset",
  "version": "1.0.0",
  "private": true,
  "description": "Base de données historique et cartographie interactive des opérations de l'ALN (1954-1962)",
  "scripts": {
    "test": "npm run test:api && npm run test:data",
    "test:api": "node --test tests/*.test.js",
    "test:blind": "node tests/blind-test.js",
    "test:data": "node tests/run-validation.js",
    "build:data": "node scripts/sync-dataset.js",
    "migrate:legacy": "node scripts/migrate-legacy.js",
    "build:canonical": "node scripts/build-canonical.js",
    "check:canonical": "node scripts/build-canonical.js --check",
    "test:browser": "playwright test",
    "build:documentation": "node scripts/build-documentation.js",
    "check:documentation": "node scripts/build-documentation.js --check",
    "validate:canonical": "node scripts/validate-canonical.js",
    "build": "npm run build:canonical && npm run build:documentation"
  },
  "dependencies": {
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chart.js": "^4.6.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "markdown-it": "^15.0.3"
  }
}
