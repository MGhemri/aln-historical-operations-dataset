# Vercel Environment Variables for Contact Form SMTP
SMTP_HOST=mail.connect-gm.com
SMTP_PORT=465
SMTP_USER=dataset@connect-gm.com
SMTP_PASS=replace-with-server-only-secret
CONTACT_DEST=dataset@connect-gm.com, contact@connect-gm.com

# Optional: defaults to CONTACT_DEST
CONTRIBUTION_DEST=dataset@connect-gm.com, contact@connect-gm.com
