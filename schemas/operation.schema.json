{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://alnop.vercel.app/schemas/operation.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["id","schema_version","title","start_date","end_date","locations","territorial_assignments","source_ids","editorial_status","quality_flags","provenance","legacy","legacy_territorial_label"],
  "properties":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9_-]+$"},
    "schema_version":{"const":"2.0.0"},
    "title":{"type":"object","additionalProperties":false,"required":["fr","ar"],"properties":{"fr":{"type":"string","minLength":1},"ar":{"type":["string","null"]}}},
    "start_date":{"$ref":"#/$defs/date"},"end_date":{"$ref":"#/$defs/date"},
    "locations":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["label","geometry","geometry_role","review_status"],"properties":{
      "label":{"type":["string","null"]},"geometry":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["type","coordinates"],"properties":{"type":{"const":"Point"},"coordinates":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}}}}]},
      "geometry_role":{"enum":["representative_point","unknown","approximate_site","exact_site"]},"review_status":{"const":"needs_review"}}}},
    "territorial_assignments":{"type":"array","maxItems":0},
    "legacy_territorial_label":{"type":["string","null"]},
    "source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^SRC_[a-f0-9]{24}$"}},
    "editorial_status":{"enum":["proposed","under_review","published","disputed","withdrawn"]},
    "quality_flags":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source_commit","publication_basis","human_review_recorded"],"properties":{"source_commit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"publication_basis":{"const":"previously_public_legacy_corpus"},"human_review_recorded":{"const":false}}},
    "legacy":{"type":"object"}
  },
  "$defs":{"date":{"type":"object","additionalProperties":false,"required":["earliest","latest","precision","certainty"],"properties":{"earliest":{"type":["string","null"],"format":"date"},"latest":{"type":["string","null"],"format":"date"},"precision":{"enum":["day","month","year","range","unknown"]},"certainty":{"enum":["documented","approximate","disputed","unknown"]}}}}
}
